@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="page-heading"><div>
    <p class="eyebrow">OVERVIEW</p><h1>Library dashboard</h1><p>Keep your collection and lending activity in view.</p></div><a class="btn btn-primary" asp-controller="Loans" asp-action="Create">+ New loan</a></div>
<div class="row g-3 mb-4"><div class="col-sm-6 col-xl-3"><div class="stat-card"><span>Titles in catalogue</span><strong>@Model.TotalBooks</strong><small>books managed</small></div></div><div class="col-sm-6 col-xl-3"><div class="stat-card teal"><span>Available copies</span><strong>@Model.AvailableCopies</strong><small>@Model.BorrowedCopies currently borrowed</small></div></div><div class="col-sm-6 col-xl-3"><div class="stat-card blue"><span>Active members</span><strong>@Model.ActiveMembers</strong><small>ready to borrow</small></div></div><div class="col-sm-6 col-xl-3"><div class="stat-card @(Model.OverdueLoans > 0 ? "warning" : "")"><span>Overdue loans</span><strong>@Model.OverdueLoans</strong><small>need follow-up</small></div></div></div>
<div class="row g-4"><div class="col-lg-8"><section class="content-card"><div class="card-header-line"><div><h2>Recent loans</h2><p>Latest borrowing activity</p></div><a asp-controller="Loans" asp-action="Index">View all</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>BOOK</th><th>MEMBER</th><th>BORROWED</th><th>STATUS</th></tr></thead><tbody>@foreach (var loan in Model.RecentLoans) { <tr><td><a asp-controller="Loans" asp-action="Details" asp-route-id="@loan.Id">@loan.Book!.Title</a></td><td>@loan.Member!.FullName</td><td>@loan.BorrowedDate.ToString("dd MMM yyyy")</td><td>@if (loan.IsOverdue) { <span class="badge text-bg-danger">Overdue</span> } else { <span class="badge @(loan.Status == LoanStatus.Returned ? "text-bg-secondary" : "text-bg-success")">@loan.Status</span> }</td></tr>} @if (!Model.RecentLoans.Any()) { <tr><td colspan="4" class="empty">No lending activity yet.</td></tr> }</tbody></table></div></section></div><div class="col-lg-4"><section class="content-card mb-4"><h2>Quick actions</h2><div class="quick-actions"><a asp-controller="Books" asp-action="Create">+ Add book</a><a asp-controller="Members" asp-action="Create">+ Register member</a><a asp-controller="Loans" asp-action="Create">+ New loan</a></div></section><section class="content-card"><div class="card-header-line"><h2>Needs attention</h2><a asp-controller="Loans" asp-action="Overdue">View</a></div>@foreach (var loan in Model.OverdueLoanList) { <div class="overdue-item"><strong>@loan.Book!.Title</strong><span>@loan.Member!.FullName · due @loan.DueDate.ToString("dd MMM")</span></div> } @if (!Model.OverdueLoanList.Any()) { <p class="muted mb-0">No overdue loans. Nice work.</p> }</section></div></div>
