@model IEnumerable<Book>
@{ ViewData["Title"] = "Books"; }
<div class="page-heading"><div><p class="eyebrow">CATALOGUE</p><h1>Books</h1><p>Manage your library collection.</p></div><a class="btn btn-primary" asp-action="Create">+ Add book</a></div>
<section class="content-card"><form class="row g-2 mb-4"><div class="col-md-5"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search title, author or ISBN" /></div><div class="col-md-3"><select class="form-select" name="category"><option value="">All categories</option>@foreach (string c in ViewBag.Categories) { <option value="@c" selected="@(ViewBag.Category == c)">@c</option>}</select></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button></div></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>BOOK</th><th>AUTHOR</th><th>CATEGORY</th><th>ISBN</th><th>COPIES</th><th>AVAILABILITY</th><th></th></tr></thead><tbody>@foreach(var book in Model) { <tr><td><a asp-action="Details" asp-route-id="@book.Id"><strong>@book.Title</strong></a></td><td>@book.Author</td><td>@book.Category</td><td>@book.Isbn</td><td>@book.AvailableCopies / @book.TotalCopies</td><td>@if(book.AvailableCopies == 0){<span class="badge text-bg-danger">Unavailable</span>}else if(book.AvailableCopies <= 2){<span class="badge text-bg-warning">Low stock</span>}else{<span class="badge text-bg-success">Available</span>}</td><td class="text-end"><a asp-action="Details" asp-route-id="@book.Id">View</a> · <a asp-action="Edit" asp-route-id="@book.Id">Edit</a></td></tr>} @if(!Model.Any()){<tr><td colspan="7" class="empty">No books found.</td></tr>}</tbody></table></div></section>
