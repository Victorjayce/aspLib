@model Book
@{ ViewData["Title"] = "Edit book"; }
<div class="page-heading"><div><p class="eyebrow">CATALOGUE</p><h1>Edit book</h1><p>Update title information and stock.</p></div></div>
<form asp-action="Edit" class="content-card form-card"><input type="hidden" asp-for="Id" /><partial name="_BookForm" model="Model" /><p class="muted">Available copies are calculated from total copies and books currently on loan.</p><div class="form-actions"><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Cancel</a><button class="btn btn-primary">Save changes</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
