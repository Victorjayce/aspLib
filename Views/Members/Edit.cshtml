@model Member
@{ ViewData["Title"] = "Edit member"; }
<div class="page-heading"><div><p class="eyebrow">COMMUNITY</p><h1>Edit member</h1><p>Update member information.</p></div></div>
<form asp-action="Edit" class="content-card form-card"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="DateRegistered" /><partial name="_MemberForm" model="Model" /><div class="form-actions"><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Cancel</a><button class="btn btn-primary">Save changes</button></div></form>
