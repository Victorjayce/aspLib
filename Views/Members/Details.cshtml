@model Member
@{ ViewData["Title"] = "Member details"; var current = Model.Loans.Where(l => l.Status == LoanStatus.Borrowed); }
<div class="page-heading"><div><p class="eyebrow">MEMBER DETAILS</p><h1>@Model.FullName</h1><p>@Model.Email</p></div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a></div><div class="row g-4"><div class="col-lg-4"><section class="content-card detail-list"><div><span>Phone</span><strong>@Model.PhoneNumber</strong></div><div><span>Registered</span><strong>@Model.DateRegistered.ToString("dd MMM yyyy")</strong></div><div><span>Status</span><strong>@(Model.IsActive ? "Active" : "Inactive")</strong></div></section>@if(Model.IsActive){<form asp-action="Deactivate" asp-route-id="@Model.Id" class="mt-3"><button class="btn btn-outline-danger">Deactivate member</button></form>}</div><div class="col-lg-8"><section class="content-card"><h2>Loan history</h2><div class="table-responsive"><table class="table"><thead><tr><th>BOOK</th><th>DUE DATE</th><th>STATUS</th></tr></thead><tbody>@foreach(var loan in Model.Loans.OrderByDescending(l => l.BorrowedDate)){<tr><td><a asp-controller="Loans" asp-action="Details" asp-route-id="@loan.Id">@loan.Book!.Title</a></td><td>@loan.DueDate.ToString("dd MMM yyyy")</td><td>@(loan.IsOverdue ? "Overdue" : loan.Status.ToString())</td></tr>}@if(!Model.Loans.Any()){<tr><td colspan="3" class="empty">No loans recorded.</td></tr>}</tbody></table></div></section></div></div>
