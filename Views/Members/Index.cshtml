@model IEnumerable<Member>
@{ ViewData["Title"] = "Members"; }
<div class="page-heading"><div><p class="eyebrow">COMMUNITY</p><h1>Members</h1><p>Manage registered library members.</p></div><a class="btn btn-primary" asp-action="Create">+ Register member</a></div><section class="content-card"><form class="row g-2 mb-4"><div class="col-md-5"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search name, email or phone" /></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button></div></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>MEMBER</th><th>EMAIL</th><th>PHONE</th><th>REGISTERED</th><th>STATUS</th><th></th></tr></thead><tbody>@foreach(var member in Model){<tr><td><a asp-action="Details" asp-route-id="@member.Id"><strong>@member.FullName</strong></a></td><td>@member.Email</td><td>@member.PhoneNumber</td><td>@member.DateRegistered.ToString("dd MMM yyyy")</td><td><span class="badge @(member.IsActive ? "text-bg-success" : "text-bg-secondary")">@(member.IsActive ? "Active" : "Inactive")</span></td><td class="text-end"><a asp-action="Details" asp-route-id="@member.Id">View</a> · <a asp-action="Edit" asp-route-id="@member.Id">Edit</a></td></tr>} @if(!Model.Any()){<tr><td colspan="6" class="empty">No members found.</td></tr>}</tbody></table></div></section>
