@model IEnumerable<Loan>
@{ ViewData["Title"] = "Loans"; }
<div class="page-heading"><div><p class="eyebrow">LENDING</p><h1>Loans</h1><p>Track books currently with members.</p></div><a class="btn btn-primary" asp-action="Create">+ New loan</a></div><section class="content-card"><div class="filter-links mb-3"><a asp-action="Index">All</a><a asp-action="Index" asp-route-status="Borrowed">Borrowed</a><a asp-action="Index" asp-route-status="Returned">Returned</a><a asp-action="Index" asp-route-status="Overdue">Overdue</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>BOOK</th><th>MEMBER</th><th>BORROWED</th><th>DUE</th><th>RETURNED</th><th>STATUS</th><th></th></tr></thead><tbody>@foreach(var loan in Model){<tr><td><a asp-action="Details" asp-route-id="@loan.Id"><strong>@loan.Book!.Title</strong></a></td><td>@loan.Member!.FullName</td><td>@loan.BorrowedDate.ToString("dd MMM yyyy")</td><td>@loan.DueDate.ToString("dd MMM yyyy")</td><td>@(loan.ReturnedDate?.ToString("dd MMM yyyy") ?? "—")</td><td>@if(loan.IsOverdue){<span class="badge text-bg-danger">Overdue</span>}else{<span class="badge @(loan.Status == LoanStatus.Returned ? "text-bg-secondary" : "text-bg-success")">@loan.Status</span>}</td><td class="text-end"><a asp-action="Details" asp-route-id="@loan.Id">View</a></td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="empty">No loans match this filter.</td></tr>}</tbody></table></div></section>
