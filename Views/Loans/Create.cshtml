@model Loan
@{ ViewData["Title"] = "New loan"; }
<div class="page-heading"><div><p class="eyebrow">LENDING</p><h1>Create a loan</h1><p>Issue an available book to an active member.</p></div></div>
<form asp-action="Create" class="content-card form-card"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-6"><label asp-for="BookId" class="form-label"></label><select asp-for="BookId" asp-items="ViewBag.Books" class="form-select"><option value="">Select an available book</option></select><span asp-validation-for="BookId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="MemberId" class="form-label"></label><select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select"><option value="">Select an active member</option></select><span asp-validation-for="MemberId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="BorrowedDate" class="form-label"></label><input asp-for="BorrowedDate" class="form-control" /></div><div class="col-md-6"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control" /><span asp-validation-for="DueDate" class="text-danger"></span></div></div><div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary">Create loan</button></div></form>
