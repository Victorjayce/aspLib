@model Loan
@{ ViewData["Title"] = "Loan details"; }
<div class="page-heading"><div><p class="eyebrow">LOAN DETAILS</p><h1>@Model.Book!.Title</h1><p>Borrowed by @Model.Member!.FullName</p></div>@if(Model.Status == LoanStatus.Borrowed){<form asp-action="Return" asp-route-id="@Model.Id"><button class="btn btn-primary">Mark as returned</button></form>}</div><section class="content-card detail-list"><div><span>Member</span><strong><a asp-controller="Members" asp-action="Details" asp-route-id="@Model.MemberId">@Model.Member!.FullName</a></strong></div><div><span>Borrowed date</span><strong>@Model.BorrowedDate.ToString("dd MMM yyyy")</strong></div><div><span>Due date</span><strong>@Model.DueDate.ToString("dd MMM yyyy")</strong></div><div><span>Returned date</span><strong>@(Model.ReturnedDate?.ToString("dd MMM yyyy") ?? "Not returned")</strong></div><div><span>Status</span><strong>@(Model.IsOverdue ? "Overdue" : Model.Status.ToString())</strong></div></section>
