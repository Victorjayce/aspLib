<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] - LibraMGT</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body>
<div class="mobile-nav d-md-none"><div class="mobile-nav-top"><a class="mobile-brand" asp-controller="Home" asp-action="Index"><span>L</span> LibraMGT</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mobileMenu" aria-controls="mobileMenu" aria-expanded="false" aria-label="Open navigation"><span class="navbar-toggler-icon"></span></button></div><nav class="collapse" id="mobileMenu"><a asp-controller="Home" asp-action="Index">Dashboard</a><a asp-controller="Books" asp-action="Index">Books</a><a asp-controller="Members" asp-action="Index">Members</a><a asp-controller="Loans" asp-action="Index">Loans</a><a asp-controller="Loans" asp-action="Overdue">Overdue</a><a asp-controller="Home" asp-action="Privacy">About</a></nav></div>
<div class="app-shell"><aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">L</span><span>LibraMGT<small>Library administration</small></span></a><nav class="nav flex-column"><a class="nav-link" asp-controller="Home" asp-action="Index">⌂ Dashboard</a><a class="nav-link" asp-controller="Books" asp-action="Index">▣ Books</a><a class="nav-link" asp-controller="Members" asp-action="Index">♙ Members</a><a class="nav-link" asp-controller="Loans" asp-action="Index">↔ Loans</a><a class="nav-link" asp-controller="Loans" asp-action="Overdue">⚠ Overdue</a><a class="nav-link" asp-controller="Home" asp-action="Privacy">ⓘ About</a></nav><div class="sidebar-footer">Local library system<br /><span>Version 1.0</span></div></aside><main class="main-content">@if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }@if (TempData["Error"] is string error) { <div class="alert alert-danger alert-dismissible fade show">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }@RenderBody()</main></div><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
